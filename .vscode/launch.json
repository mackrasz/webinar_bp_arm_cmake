{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build-debug/webinar_arm.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/debug.cfg"
            ],
            "device": "STM32F411RETx",
            "gdbPath": "arm-none-eabi-gdb",
            "svdFile": "${workspaceFolder}/STM32F411.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 10
            }
        }
    ]
}